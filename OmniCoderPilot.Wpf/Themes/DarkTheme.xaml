<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════════
         DARK THEME — Minimal
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#171717"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Panel3Brush" Color="#262626"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="InputFocusBrush" Color="#3A3A3A"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#262626"/>
    <SolidColorBrush x:Key="Border2Brush" Color="#333333"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#222222"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#B3B3B3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#737373"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="#525252"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#525252"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="#22C55E"/>
    <SolidColorBrush x:Key="Accent3Brush" Color="#A855F7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>

    <!-- Tool step border colors -->
    <SolidColorBrush x:Key="EditBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WriteBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="ReadBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ExploreBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SearchBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="CommandBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DeleteBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WebBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="TaskBrush" Color="#F97316"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TodoProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#22C55E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- Activity banner gradients -->
    <LinearGradientBrush x:Key="ActivityThinkingBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1A2E" Offset="0"/>
        <GradientStop Color="#0F0F0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActivityToolRunningBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A1500" Offset="0"/>
        <GradientStop Color="#0F0F0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActivityErrorBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A0808" Offset="0"/>
        <GradientStop Color="#0F0F0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActivityCompletedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#081A0E" Offset="0"/>
        <GradientStop Color="#0F0F0F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActivityPermissionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A0818" Offset="0"/>
        <GradientStop Color="#0F0F0F" Offset="1"/>
    </LinearGradientBrush>

    <!-- User message tint -->
    <SolidColorBrush x:Key="UserMessageBrush" Color="#1A1A2E"/>

    <!-- Code block background -->
    <SolidColorBrush x:Key="CodeBgBrush" Color="#1A1A1A"/>

    <!-- Diff colors -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DiffHunkBrush" Color="#3B82F6"/>

    <!-- Online indicator -->
    <SolidColorBrush x:Key="OnlineBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="#525252"/>

    <!-- Fonts -->
    <FontFamily x:Key="DefaultFont" x:Shared="False">Segoe UI, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont" x:Shared="False">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeTiny">11</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeHeader">20</sys:Double>

    <!-- CornerRadius -->
    <CornerRadius x:Key="RadiusCorner">12</CornerRadius>
    <CornerRadius x:Key="RadiusSmCorner">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">99</CornerRadius>

    <!-- Shadows -->
    <DropShadowEffect x:Key="SmShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="Black"/>
    <DropShadowEffect x:Key="MdShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
    <DropShadowEffect x:Key="LgShadow" BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>

</ResourceDictionary>
