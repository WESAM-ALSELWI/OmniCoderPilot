<Window x:Class="OmniCoderPilot.Wpf.Views.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permission Required"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource DefaultFont}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="#1A2563EB" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <TextBlock Text="&#x1F510;" FontSize="22"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Permission Required" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="The agent wants to perform a potentially dangerous action"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

        <!-- Tool name -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Tool" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource Panel2Brush}" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A1;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToolNameText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource Panel2Brush}" CornerRadius="8" Padding="12,8">
                <TextBlock x:Name="DescText" FontSize="13" Foreground="{DynamicResource Text2Brush}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Arguments + Buttons -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Arguments" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource Panel3Brush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ArgsText" FontSize="12" FontFamily="{DynamicResource MonoFont}"
                               Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DenyButton" Content="Deny" Style="{StaticResource ActionBtn}"
                        Background="{DynamicResource Panel3Brush}"
                        Foreground="{DynamicResource DangerBrush}"
                        Margin="0,0,10,0" Click="Deny_Click"/>
                <Button x:Name="AllowButton" Content="Allow" Style="{StaticResource ActionBtn}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        Click="Allow_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
