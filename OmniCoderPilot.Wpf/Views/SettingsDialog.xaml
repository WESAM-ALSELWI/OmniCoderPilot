<Window x:Class="OmniCoderPilot.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OmniCoderPilot.Wpf.Converters"
        Title="Settings — AI Providers &amp; APIs"
        Width="640" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource DefaultFont}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#1A3B82F6" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                <TextBlock Text="&#x2699;" FontSize="24" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings &amp; AI Providers" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Configure OpenRouter, Groq, DeepSeek, OpenAI, Local Ollama, and Custom APIs"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

        <!-- Form fields ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. OpenRouter Section -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F310;" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="OpenRouter (Claude, GPT-4o, Gemini, DeepSeek)" FontSize="13.5"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="openrouter.ai/keys" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="API Key (sk-or-v1-...)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OpenRouterBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                        <Button Content="Test OpenRouter Connection" Command="{Binding TestOpenRouterCommand}"
                                Style="{StaticResource ActionBtn}" Background="{DynamicResource Panel2Brush}"
                                Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left" Padding="12,5"
                                FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 2. Groq Section (Free fast cloud) -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x26A1;" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Groq (Free Ultra-Fast Cloud — Llama 3.3 70B, DeepSeek R1)" FontSize="13.5"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Free key at console.groq.com" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Groq API Key (gsk_...)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding GroqApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding GroqBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                        <Button Content="Test Groq Connection" Command="{Binding TestGroqCommand}"
                                Style="{StaticResource ActionBtn}" Background="{DynamicResource Panel2Brush}"
                                Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left" Padding="12,5"
                                FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 3. DeepSeek Official Direct -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F9E0;" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="DeepSeek Official Direct (deepseek-chat, deepseek-reasoner)" FontSize="13.5"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="platform.deepseek.com" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="DeepSeek API Key (sk-...)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DeepSeekApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DeepSeekBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- 4. OpenAI Official Direct -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F916;" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="OpenAI Official Direct (gpt-4o, gpt-4o-mini, o3-mini, o1)" FontSize="13.5"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="platform.openai.com" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="OpenAI API Key (sk-...)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- 5. Custom Any API Endpoint -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F527;" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Custom Any API / Self-Hosted Endpoint" FontSize="13.5"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Use any OpenAI-compatible server (vLLM, LM Studio, LiteLLM, Together AI, Mistral, GitHub Models)"
                                   FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL (e.g. https://your-server.com/v1 or http://localhost:1234/v1)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CustomBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="API Key (optional if local)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CustomApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Custom Model Names (comma-separated, e.g. custom-model, llama3)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding CustomModels, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,10"/>

                        <Button Content="Test Custom Endpoint" Command="{Binding TestCustomEndpointCommand}"
                                Style="{StaticResource ActionBtn}" Background="{DynamicResource Panel2Brush}"
                                Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left" Padding="12,5"
                                FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 6. Local Ollama & Web Search Section -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F4BB;" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Local Ollama &amp; Web Search" FontSize="13.5"
                                       FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Local Ollama Server URL" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" Margin="0,0,0,8"/>

                        <TextBlock Text="Brave Search API Key (Optional — Web Search)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BraveSearchApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Message Banner -->
        <Border Grid.Row="3" Margin="0,0,0,12" Padding="12,8" CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource StrToVis}}"
                Background="{DynamicResource Panel2Brush}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ActionBtn}"
                    Background="{DynamicResource Panel2Brush}" Foreground="{DynamicResource MutedBrush}"
                    Margin="0,0,10,0" Padding="16,8"/>
            <Button Content="Save &amp; Apply All" Command="{Binding SaveCommand}" Style="{StaticResource ActionBtn}"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
